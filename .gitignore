# Dependencies
node_modules/

# Build output
dist/
dist-electron/

# Environment and secrets
.env
.env.local
*.local

# Personal profile data (contains PII)
data/profile.json

# What the tool found and requested at each broker (listing addresses carry
# the person's name), its write-in-progress temp file, and screenshots of
# listings and confirmations. Named explicitly so the rule survives a change
# of image format.
data/state.json
data/state.json.*
data/evidence/

# Claude Code local settings
.claude/settings.local.json

# IDE
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Run result logs (which brokers were contacted and each outcome).
# Unanchored on purpose: the desktop app writes them to data/, the CLI
# writes them to whatever directory it was started from.
optouts-*.jsonl

# Test coverage
coverage/

# Temporary files
tmp/
temp/
.temp/

# Test screenshots
*.png
