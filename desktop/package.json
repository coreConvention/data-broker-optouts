{
  "name": "data-broker-optouts-desktop",
  "version": "1.0.0",
  "description": "Desktop application for automating data broker opt-out requests",
  "main": "dist/main/main.js",
  "author": "Data Broker Optouts Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "cd renderer && npx ng serve --port 4201",
    "dev:electron": "npm run build:engine && npx wait-on http://localhost:4201 && npm run build:main && npx electron .",
    "build": "npm run build:engine && npm run build:renderer && npm run build:main",
    "build:engine": "cd .. && npx tsc -p tsconfig.engine.json && node -e \"require('fs').writeFileSync('desktop/dist/engine/package.json','{\\\"type\\\":\\\"module\\\"}\\n')\"",
    "build:renderer": "cd renderer && npx ng build --configuration production",
    "build:main": "tsc -p tsconfig.main.json",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "package:all": "npm run build && electron-builder --win --mac --linux"
  },
  "dependencies": {
    "@playwright/test": "^1.65.1",
    "electron-updater": "^6.3.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.databrokeroptouts.app",
    "productName": "Data Broker Opt-Outs",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "../data",
        "to": "data",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "Utility"
    },
    "publish": {
      "provider": "github",
      "owner": "coreConvention",
      "repo": "data-broker-optouts"
    }
  }
}
